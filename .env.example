# ==============================================================================
# DayTone Environment Configuration Template
# ==============================================================================
# IMPORTANT: Copy this file to '.env' in the same directory.
# NEVER commit the actual '.env' file to Git or version control.
# Keep all production credentials strictly secret.
# ==============================================================================

# Flask Session Security Key (change this to a random string in production)
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me

# Symmetric Fernet Key for database notes encryption-at-rest.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# Error tracking (Sentry DSN) — leave blank to disable
SENTRY_DSN=

# Database Connection URI.
# SQLite is fine for development, but PostgreSQL is ENFORCED in production.
# Example: DATABASE_URL=postgresql://user:password@host:5432/daytone
DATABASE_URL=sqlite:///daytone.db

# Flask Environment State: development / production
FLASK_ENV=development

# Session and Rate Limiter settings
SESSION_COOKIE_SECURE=false
RATELIMIT_STORAGE_URI=memory://
COUNTRY=GLOBAL

# Notification Email SMTP settings
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=

# Admin configuration (Use a strong unique code for registration)
ADMIN_ALERT_EMAIL=
ADMIN_REGISTRATION_CODE=

