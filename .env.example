SECRET_KEY=change-me
# Use PostgreSQL in production, for example:
# DATABASE_URL=postgresql://user:password@host:5432/daytone
DATABASE_URL=sqlite:///daytone.db
FLASK_ENV=development
# Set to false ONLY for local HTTP development.
SESSION_COOKIE_SECURE=false
# Use redis://localhost:6379/0 in production; memory:// is per-process only.
RATELIMIT_STORAGE_URI=memory://
COUNTRY=GLOBAL

MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=
ADMIN_ALERT_EMAIL=
ADMIN_REGISTRATION_CODE=
